# Network: "localhost" (Hardhat, dev keys built in) or e.g. "base-sepolia"
ZEROUP_NETWORK=base-sepolia
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
# DEPLOYMENT_FILE=deployments/base-sepolia.json

# Deploy (npm run deploy). TOKEN_ADDRESS defaults to native USDC on Base / Base Sepolia.
DEPLOYER_PRIVATE_KEY=
# SCREENER_OWNER=0x...   compliance multisig that manages the screening list

# Services (npm run serve -- <sponsor|facilitator|merchant|wallet>)
HOST=127.0.0.1
SPONSOR_PRIVATE_KEY=
SPONSOR_PORT=4010
SPONSOR_WITHDRAW_FEE=2000          # atomic USDC units taken per withdrawal (0.002 USDC)
FACILITATOR_PRIVATE_KEY=
FACILITATOR_PORT=4020
MERCHANT_PAY_TO=
MERCHANT_PORT=4030

# Wallet / CLI
SPONSOR_URL=http://127.0.0.1:4010
FACILITATOR_URL=http://127.0.0.1:4020
ZEROUP_DATA_DIR=data
ZEROUP_PASSPHRASE=
FUNDER_PRIVATE_KEY=                # public wallet that signs gasless deposits
WALLET_PORT=4040
WALLET_API_TOKEN=                  # require "Authorization: Bearer <token>" on /api
LOG_CHUNK_SIZE=5000                # eth_getLogs block range; lower it for strict RPCs
SPONSOR_MIN_DEPOSIT=10000          # smallest gasless deposit (0.01 USDC)
FACILITATOR_API_KEY=               # if set, merchants must send it; stops free-gas abuse
WALLET_HOST=127.0.0.1              # non-loopback requires WALLET_API_TOKEN
WALLET_ALLOWED_HOSTS=              # extra Host names for the dashboard (DNS-rebinding guard)
