{
  "name": "zeroup",
  "version": "0.1.0",
  "private": true,
  "description": "Zeroup: private, gasless x402 payments from a shielded balance",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:circuits": "./scripts/build-circuits.sh",
    "build:contracts": "hardhat compile && node scripts/export-abis.js",
    "build": "npm run build:contracts",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test --test-concurrency=1 test/unit.test.ts test/e2e.test.ts",
    "node": "hardhat node",
    "deploy": "tsx src/bin/deploy.ts",
    "dev": "tsx src/bin/dev.ts",
    "demo": "tsx src/bin/demo.ts",
    "serve": "tsx src/bin/serve.ts",
    "zeroup": "tsx src/bin/cli.ts"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/bip39": "1.6.0",
    "circomlibjs": "0.1.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "snarkjs": "0.7.6",
    "viem": "2.57.11"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "2.1.1",
    "@openzeppelin/contracts": "5.3.0",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "circom2": "0.2.23",
    "circomlib": "2.0.5",
    "hardhat": "2.29.1",
    "poseidon-solidity": "0.0.5",
    "solc": "0.8.24",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "bin": {
    "zeroup": "bin/zeroup"
  }
}
